# Copy to .env (never committed) and fill in your eBay Production keyset.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# Optional: where item folders live (default ~/Listings/inbox)
LISTER_INBOX=
# Optional: path to the claude CLI if it isn't on PATH (e.g. a project-local npm install)
CLAUDE_BIN=
# eBay sign-in for listing (see README 'eBay sign-in'): the RuName from Developer Portal > User Tokens
EBAY_RUNAME=
